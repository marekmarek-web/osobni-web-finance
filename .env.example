# Vercel / lokální – API send-report, Supabase, FP pro poradce (Stripe)
# Zkopíruj na .env.local (necommituj) a vyplň hodnoty.
# Na Vercelu nastav v Dashboard → Settings → Environment Variables.

# Diagnostika – e-maily
RESEND_API_KEY=
MAIL_FROM=diagnostika@yourdomain.com
MAIL_TO_MAREK=marek@example.com
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CALENDLY_URL=https://calendly.com/your-link

# FP pro poradce – předplatné (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SUPABASE_ANON_KEY=
