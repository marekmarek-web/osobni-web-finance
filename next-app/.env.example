# Next.js kalkulačky — lokální vývoj
# Zkopíruj do next-app/.env.local

# Náhledový režim (zobrazí žlutý banner s odkazem na statické HTML)
# NEXT_PUBLIC_CALCULATOR_PREVIEW=true

# Homepage: přesměrovat / na statické index.html (výchozí: ano)
# NEXT_PUBLIC_USE_STATIC_HOME=false

# Odkazy mimo Next trasy (Služby, Finanční plán…) — produkční doména
NEXT_PUBLIC_STATIC_SITE_ORIGIN=https://marek-marek.cz

# Leady z kalkulaček (FormSubmit proxy v /api/leads)
# FORMSUBMIT_EMAIL=kontakt@marek-marek.cz

# Legacy diagnostika / FP poradce (stejné jako kořenové .env.example)
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO_MAREK=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
CALENDLY_URL=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
